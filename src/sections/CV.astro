---
import Section from "../components/ui/Section.astro";
import CVItem from "../components/CVItem.astro";

const experiencia = [
  {
    title: "Programador — Equipo Docente",
    entity: "FAPyD · Universidad Nacional de Rosario",
    period: "Ago 2024 — Dic 2025",
    description: "Desarrollo y optimización de código Python con POO en producción académica. Capacitación técnica a alumnos sin experiencia. Corrección de errores + documentación técnica.",
    badges: ["Python", "POO", "Docencia", "Documentación"],
    current: false,
  },
  {
    title: "Técnico Independiente",
    entity: "Soporte y Desarrollo Web",
    period: "Oct 2021 — Actual",
    description: "Aplicaciones web PHP con arquitectura MVC. Gestión end-to-end de incidentes con documentación formal. Coordinación de equipos según criticidad e impacto. Presupuestación y gestión de proyectos.",
    badges: ["PHP", "MVC", "MySQL", "Soporte", "Autogestión"],
    current: true,
  },
  {
    title: "Técnico de Área",
    entity: "GESTAM Argentina S.A. — Soporte y Gestión de Incidentes",
    period: "Ene 2013 — Sep 2021",
    description: "Incidentes críticos en instalaciones bancarias con análisis de causa raíz. Nexo entre soporte, proveedores y clientes. Capacitación de técnicos y onboarding. Coordinación directa del área.",
    badges: ["Soporte", "Incidentes", "Bancos", "Coordinación"],
    current: false,
  },
];

const educacion = [
  {
    title: "Ingeniería en Sistemas de Información",
    entity: "UTN — Facultad Regional Paraná",
    period: "2025 — Actual",
    description: "1° año en curso. Formación en algoritmos, estructuras de datos, bases de datos y arquitectura de software.",
    badges: ["UTN", "Algoritmos", "Bases de Datos"],
  },
  {
    title: "Programador Full Stack",
    entity: "Argentina Programa 4.0",
    period: "Dic 2022",
    description: "Certificación oficial en desarrollo web fullstack.",
    badges: ["Full Stack", "Certificación"],
  },
  {
    title: "Técnico en Electrónica",
    entity: "EET N°465 Gral. Manuel Belgrano",
    period: "Dic 2012",
    description: "Formación técnica en electrónica.",
    badges: ["Electrónica", "Técnico"],
  },
];

const cursos = [
  { title: "Inglés B1", entity: "Lectura técnica y comunicación escrita", period: "En curso", description: "Comprensión de documentación técnica y comunicación escrita en inglés.", badges: ["Inglés", "B1"] },
];
// TODO: Reemplazar cursos placeholder por certificaciones reales
---

<Section id="cv" class="scroll-mt-16 bg-surface/50" aria-labelledby="cv-heading">
  <div class="mx-auto max-w-[1280px]">
    <h2 id="cv-heading" class="font-display text-2xl md:text-3xl font-bold text-text">Experiencia / CV</h2>
    <p class="mt-2 max-w-2xl text-sm text-text-muted">Trayectoria escaneable. Imprimible con <kbd class="rounded border border-border bg-surface px-1 py-0.5 text-xs">Ctrl+P</kbd>.</p>

    <div class="mt-10 grid gap-10 lg:grid-cols-3">
      <!-- Experiencia -->
      <div class="lg:col-span-1">
        <h3 class="font-display text-lg font-semibold text-text">Experiencia</h3>
        <ol class="mt-4 space-y-8 border-l-2 border-border ml-2 pl-6" aria-label="Experiencia laboral">
          {experiencia.map(item => <CVItem {...item} />)}
        </ol>
      </div>

      <!-- Educación -->
      <div class="lg:col-span-1">
        <h3 class="font-display text-lg font-semibold text-text">Educación</h3>
        <ol class="mt-4 space-y-8 border-l-2 border-border ml-2 pl-6" aria-label="Educación">
          {educacion.map(item => <CVItem {...item} />)}
        </ol>
      </div>

      <!-- Cursos -->
      <div class="lg:col-span-1">
        <h3 class="font-display text-lg font-semibold text-text">Cursos / Certificaciones</h3>
        <ol class="mt-4 space-y-8 border-l-2 border-border ml-2 pl-6" aria-label="Cursos y certificaciones">
          {cursos.map(item => <CVItem {...item} />)}
        </ol>
        <p class="mt-6 text-xs text-text-muted">¿Tenés cursos para sumar? Edita <code class="rounded bg-surface border border-border px-1 py-0.5 text-xs">src/sections/CV.astro:6</code>.</p>
      </div>
    </div>

    <div class="mt-10 flex justify-center">
      <a href="#contacto" class="inline-flex items-center justify-center rounded-lg px-5 py-2.5 text-sm font-semibold bg-accent text-on-accent hover:bg-accent-hover border border-transparent transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg">
        Disponible para proyectos → Contacto
      </a>
    </div>
  </div>
</Section>
