---
import Section from "../components/ui/Section.astro";
import ProyectosGrid from "../components/ProyectosGrid";
import { getProyectos } from "../lib/wp-queries";
import type { Proyecto } from "../lib/types";

let proyectos: Proyecto[] = await getProyectos();

// Fallback genérico si WP vacío
const fallback: Proyecto[] = [
  {
    id: "fallback-1",
    title: "AppSalon — Sistema de gestión de turnos",
    slug: "appsalon",
    excerpt: "Arquitectura MVC, autenticación, panel admin, base de datos relacional. Sistema completo para gestión de turnos en peluquerías/salones.",
    content: null,
    featuredImage: { node: { sourceUrl: "/img/appsalon.png", altText: "AppSalon — Dashboard de gestión de turnos" } },
    proyectoFields: { proyectoUrl: null, repoUrl: "https://github.com/AngelAyal4/appsalon-phpmvc", techStack: ["PHP","MySQL","JavaScript","SCSS","MVC"] },
    categoriasProyecto: { nodes: [{ name:"Fullstack", slug:"fullstack" }] },
  },
  {
    id: "fallback-2",
    title: "UpTask — Gestor de tareas Kanban",
    slug: "uptask",
    excerpt: "CRUD completo, autenticación, manejo de estados. Tablero kanban para gestión de proyectos.",
    content: null,
    featuredImage: { node: { sourceUrl: "/img/uptask.png", altText: "UpTask — Tablero kanban de tareas" } },
    proyectoFields: { proyectoUrl: null, repoUrl: "https://github.com/AngelAyal4/Uptask-mvc", techStack: ["PHP","MVC","MySQL","Composer"] },
    categoriasProyecto: { nodes: [{ name:"Fullstack", slug:"fullstack" }] },
  },
  {
    id: "fallback-3",
    title: "DevWebCamp — Plataforma de conferencias",
    slug: "devwebcamp",
    excerpt: "Registro, ponentes, agenda dinámica. Plataforma de conferencias con panel administrativo.",
    content: null,
    featuredImage: { node: { sourceUrl: "/img/devwebcamp.png", altText: "DevWebCamp — Plataforma de conferencias" } },
    proyectoFields: { proyectoUrl: null, repoUrl: "https://github.com/AngelAyal4/DebWebCamp", techStack: ["PHP","MVC","MySQL","JavaScript"] },
    categoriasProyecto: { nodes: [{ name:"Fullstack", slug:"fullstack" }] },
  },
];

const isFallback = proyectos.length === 0;
if (isFallback) proyectos = fallback;
---

<Section id="proyectos" class="scroll-mt-16" aria-labelledby="proyectos-heading">
  <div class="mx-auto max-w-[1280px]">
    <div class="flex items-baseline justify-between gap-4">
      <h2 id="proyectos-heading" class="font-display text-2xl md:text-3xl font-bold text-text">Proyectos</h2>
      {isFallback && <span class="text-xs text-text-muted">Mostrando ejemplos — conecta WP para ver reales</span>}
    </div>
    <p class="mt-2 max-w-2xl text-sm text-text-muted">Filtrá por categoría. Datos desde WordPress vía WPGraphQL.</p>

    <div class="mt-8">
      <ProyectosGrid proyectos={proyectos} client:load />
    </div>
  </div>
</Section>
