---
interface Props {
  id?: string;
  class?: string;
  "aria-labelledby"?: string;
  "aria-label"?: string;
}

const { id, class: className, "aria-labelledby": ariaLabelledby, "aria-label": ariaLabel } = Astro.props;
---

<section
  id={id}
  aria-labelledby={ariaLabelledby}
  aria-label={ariaLabel}
  class:list={["py-16 md:py-24", className]}
>
  <div class="mx-auto max-w-[1280px] px-4 sm:px-6 lg:px-8">
    <slot />
  </div>
</section>
