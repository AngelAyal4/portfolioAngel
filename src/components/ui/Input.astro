---
type InputType =
  | "text"
  | "email"
  | "password"
  | "search"
  | "tel"
  | "url"
  | "number";

interface Props {
  label: string;
  id: string;
  name: string;
  type?: InputType;
  placeholder?: string;
  required?: boolean;
  multiline?: boolean;
  rows?: number;
  class?: string;
}

const {
  label,
  id,
  name,
  type = "text",
  placeholder,
  required = false,
  multiline = false,
  rows = 4,
  class: className,
} = Astro.props;

const fieldClass =
  "w-full rounded-lg border border-border bg-surface px-3 py-2.5 text-sm text-text placeholder:text-text-muted focus:border-accent focus:ring-2 focus:ring-accent/20 focus:outline-none transition-colors";
---

<div class:list={["flex flex-col gap-1.5", className]}>
  <label for={id} class="text-sm font-medium text-text">
    {label}{required && <span aria-hidden="true" class="text-accent"> *</span>}
  </label>
  {
    multiline ? (
      <textarea
        id={id}
        name={name}
        placeholder={placeholder}
        required={required}
        rows={rows}
        class:list={[fieldClass, "resize-y min-h-[96px]"]}
      />
    ) : (
      <input
        id={id}
        name={name}
        type={type}
        placeholder={placeholder}
        required={required}
        class={fieldClass}
      />
    )
  }
</div>
