---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<div
  class:list={["pointer-events-none fixed inset-0 -z-10 overflow-hidden", className]}
  aria-hidden="true"
>
  <svg
    class="absolute inset-0 h-full w-full"
    viewBox="0 0 1440 900"
    preserveAspectRatio="none"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
  >
    <!-- Pistas — stroke fino, opacidad decorativa 0.08 -->
    <g
      stroke="var(--token-accent)"
      stroke-width="0.7"
      fill="none"
      opacity="0.08"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <!-- Horizontales largas -->
      <path d="M0 80 H 320 V 140 H 600 V 80 H 900"></path>
      <path d="M0 180 H 260 V 260 H 540 V 180 H 820 V 220 H 1100"></path>
      <path d="M1440 120 H 1080 V 200 H 820 V 120 H 600"></path>
      <path d="M0 320 H 180 V 400 H 420 V 360 H 700"></path>
      <path d="M1440 300 H 1200 V 380 H 980 V 300 H 760"></path>
      <!-- Verticales -->
      <path d="M220 0 V 180 H 400 V 320"></path>
      <path d="M520 0 V 100 H 680 V 240 H 840"></path>
      <path d="M980 0 V 160 H 1120 V 280 H 1280"></path>
      <path d="M360 900 V 640 H 540 V 520 H 700"></path>
      <path d="M780 900 V 680 H 980 V 560 H 1120"></path>
      <path d="M1100 900 V 720 H 900 V 600 H 740"></path>
      <!-- Codos y derivaciones -->
      <path d="M140 400 H 260 V 520 H 120 V 600 H 360"></path>
      <path d="M700 400 H 880 V 480 H 1080 V 420 H 1260"></path>
      <path d="M420 600 H 600 V 720 H 820 V 640 H 1000"></path>
      <path d="M0 720 H 200 V 640 H 400 V 760 H 540"></path>
      <path d="M1440 660 H 1240 V 740 H 1080 V 680 H 900"></path>
      <path d="M640 200 H 760 V 360 H 620 V 480 H 800"></path>
    </g>
    <!-- Nodos / pads — círculos y rects pequeños, opacidad 0.12 -->
    <g fill="var(--token-accent)" opacity="0.12">
      <circle cx="320" cy="80" r="3.5"></circle>
      <circle cx="600" cy="80" r="2.5"></circle>
      <circle cx="260" cy="180" r="3"></circle>
      <circle cx="540" cy="260" r="2.5"></circle>
      <circle cx="820" cy="180" r="3"></circle>
      <circle cx="220" cy="180" r="2"></circle>
      <circle cx="680" cy="100" r="2.5"></circle>
      <circle cx="980" cy="160" r="3"></circle>
      <circle cx="360" cy="640" r="2.5"></circle>
      <circle cx="540" cy="520" r="3"></circle>
      <circle cx="980" cy="560" r="3"></circle>
      <circle cx="700" cy="400" r="2.5"></circle>
      <rect x="518" y="238" width="6" height="6" rx="1"></rect>
      <rect x="878" y="478" width="6" height="6" rx="1"></rect>
      <rect x="598" y="718" width="6" height="6" rx="1"></rect>
      <rect x="838" y="638" width="6" height="6" rx="1"></rect>
    </g>
  </svg>
  <!-- Barrido luminoso vertical — GPU: solo transform/opacity -->
  <div class="animate-pcb-sweep absolute inset-0 bg-gradient-to-b from-transparent via-accent/[0.07] to-transparent">
  </div>
</div>
